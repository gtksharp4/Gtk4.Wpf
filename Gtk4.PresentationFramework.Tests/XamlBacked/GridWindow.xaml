<Window x:Class="Gtk4.PresentationFramework.Tests.XamlBacked.GridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GridWindow" Width="400" Height="300">
	<Grid x:Name="Root">
		<Grid.RowDefinitions>
			<RowDefinition Height="40px"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="2*"/>
		</Grid.RowDefinitions>
		<Button x:Name="Row0" Grid.Row="0" Content="row 0"/>
		<Button x:Name="Row1" Grid.Row="1" Content="row 1"/>
		<Button x:Name="Row2" Grid.Row="2" Content="row 2"/>
	</Grid>
</Window>
