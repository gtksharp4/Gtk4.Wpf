<Window x:Class="Gtk4.PresentationFramework.Tests.XamlBacked.DynamicBrushWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicBrushWindow" Width="200" Height="100">
	<Grid x:Name="Root">
		<Grid.Resources>
			<SolidColorBrush x:Key="b" Color="Red"/>
			<GeometryDrawing x:Key="g" Brush="{DynamicResource b}"/>
		</Grid.Resources>
	</Grid>
</Window>
