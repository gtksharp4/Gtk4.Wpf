<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk4.PresentationFramework.Tests</AssemblyName>
    <RootNamespace>Gtk4.PresentationFramework.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <!-- Disable xUnit auto entry point: Program.cs provides a custom one for macOS thread-0. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <_GFMarkupCompilerTasksDir>$(MSBuildThisFileDirectory)..\Gtk4.MarkupCompiler\bin\$(Configuration)\netstandard2.0\</_GFMarkupCompilerTasksDir>
    <_GFMarkupCompilerUseTaskHost>true</_GFMarkupCompilerUseTaskHost>
    <NoWarn>$(NoWarn);xUnit1026;xUnit1031;xUnit1051;xUnit2000;xUnit2003;xUnit2004;xUnit2007;xUnit2013;xUnit2015;xUnit2017;xUnit2021;CS0436</NoWarn>
    <!-- GTK4 compat shims are [Obsolete]; demote to warnings matching the sibling projects. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk4.PresentationFramework\Gtk4.PresentationFramework.csproj" />
    <!-- Build-order only: the markup-compiler task assembly must exist before CoreCompile. -->
    <ProjectReference Include="..\Gtk4.MarkupCompiler\Gtk4.MarkupCompiler.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ResourceStreamData/embedded-sample.txt" />
  </ItemGroup>

  <!-- XAML-backed test windows are compiled by the real markup compiler, as in a converted WPF app. -->
  <ItemGroup>
    <Page Include="XamlBacked\*.xaml" />
  </ItemGroup>

  <Import Project="..\Gtk4.MarkupCompiler\build\Gtk4.MarkupCompiler.targets" />

</Project>
