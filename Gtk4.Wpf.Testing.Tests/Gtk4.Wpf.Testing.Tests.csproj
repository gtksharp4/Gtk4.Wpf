<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk4.Wpf.Testing.Tests</AssemblyName>
    <RootNamespace>Gtk4.Wpf.Testing.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <!-- The sample sources predate nullable annotations. -->
    <Nullable>disable</Nullable>
    <!-- Program.cs is the entry point: on macOS it hands thread 0 to GTK. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <_GFMarkupCompilerTasksDir>$(MSBuildThisFileDirectory)..\Gtk4.MarkupCompiler\bin\$(Configuration)\netstandard2.0\</_GFMarkupCompilerTasksDir>
    <_GFMarkupCompilerUseTaskHost>true</_GFMarkupCompilerUseTaskHost>
    <!-- The official sample sources below are compiled unmodified; their own style warnings are not ours. -->
    <NoWarn>$(NoWarn);xUnit1051;CS0436;CS0168;CS0169;CS0219;CS0649;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk4.Wpf.Testing\Gtk4.Wpf.Testing.csproj" />
    <ProjectReference Include="..\Gtk4.WpfSample\Gtk4.WpfSample.csproj" />
    <!-- Build-order only: the markup-compiler task assembly must exist before CoreCompile. -->
    <ProjectReference Include="..\Gtk4.MarkupCompiler\Gtk4.MarkupCompiler.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Official WPF-Samples compiled in process, unmodified: each sample's MainWindow (XAML + code-behind) and its
    data classes. App.xaml is left out; WpfAppHost shows the window itself.
  -->
  <PropertyGroup>
    <Samples>..\WPF-Samples\</Samples>
  </PropertyGroup>
  <ItemGroup>
    <Page Include="$(Samples)Data Binding\SimpleBinding\MainWindow.xaml" />
    <Compile Include="$(Samples)Data Binding\SimpleBinding\MainWindow.cs;$(Samples)Data Binding\SimpleBinding\Person.cs" />

    <Page Include="$(Samples)Data Binding\MasterDetail\MainWindow.xaml" />
    <Compile Include="$(Samples)Data Binding\MasterDetail\MainWindow.cs;$(Samples)Data Binding\MasterDetail\Division.cs;$(Samples)Data Binding\MasterDetail\DivisionList.cs;$(Samples)Data Binding\MasterDetail\League.cs;$(Samples)Data Binding\MasterDetail\LeagueList.cs;$(Samples)Data Binding\MasterDetail\Team.cs;$(Samples)Data Binding\MasterDetail\TeamList.cs" />

    <Page Include="$(Samples)Data Binding\DirectionalBinding\MainWindow.xaml" />
    <Compile Include="$(Samples)Data Binding\DirectionalBinding\MainWindow.cs;$(Samples)Data Binding\DirectionalBinding\NetIncome.cs" />

    <Page Include="$(Samples)Input and Commands\HandlingEventOnCommandUsingCode\MainWindow.xaml" />
    <Compile Include="$(Samples)Input and Commands\HandlingEventOnCommandUsingCode\MainWindow.cs" />

    <Page Include="$(Samples)Input and Commands\MousePointer\MainWindow.xaml" />
    <Compile Include="$(Samples)Input and Commands\MousePointer\MainWindow.cs" />

    <Page Include="$(Samples)Data Binding\XmlDataSource\MainWindow.xaml" />
    <Compile Include="$(Samples)Data Binding\XmlDataSource\MainWindow.cs" />

    <Page Include="$(Samples)Data Binding\CompositeCollections\MainWindow.xaml" />
    <Compile Include="$(Samples)Data Binding\CompositeCollections\MainWindow.cs;$(Samples)Data Binding\CompositeCollections\GreekGod.cs;$(Samples)Data Binding\CompositeCollections\GreekGods.cs" />

    <Page Include="$(Samples)Graphics\VisualBrush\App.xaml;$(Samples)Graphics\VisualBrush\SampleViewer.xaml;$(Samples)Graphics\VisualBrush\PaintingWithVisuals.xaml;$(Samples)Graphics\VisualBrush\MagnifyingGlassExample.xaml;$(Samples)Graphics\VisualBrush\ReflectionExample.xaml" />
    <Compile Include="$(Samples)Graphics\VisualBrush\App.cs;$(Samples)Graphics\VisualBrush\SampleViewer.cs;$(Samples)Graphics\VisualBrush\PaintingWithVisuals.cs;$(Samples)Graphics\VisualBrush\MagnifyingGlassExample.cs;$(Samples)Graphics\VisualBrush\ReflectionExample.cs" />
  </ItemGroup>

  <Import Project="..\Gtk4.MarkupCompiler\build\Gtk4.MarkupCompiler.targets" />

</Project>
