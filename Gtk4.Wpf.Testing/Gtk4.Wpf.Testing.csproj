<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk4.Wpf.Testing</AssemblyName>
    <RootNamespace>Gtk4.Wpf.Testing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
    <PackageId>Gtk4.Wpf.Testing</PackageId>
    <Description>UI test driver for WPF apps running on Gtk4.Wpf: in-process app host, locators, waits, semantic and routed input, screenshots and failure evidence, with xUnit integration.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk4.WindowsBase\Gtk4.WindowsBase.csproj" />
    <ProjectReference Include="..\Gtk4.PresentationFramework\Gtk4.PresentationFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gtk4.Wpf.Testing.Tests" Key="$(Gtk4FormsPublicKey)" />
  </ItemGroup>


  <!--
    The driver reaches into PresentationFramework internals (InternalsVisibleTo), so a packed dependency on it must
    match the build exactly: an open "greater or equal" range would fail with MissingMethodException at run time.
  -->
  <Target Name="PinProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)"
                                      ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
