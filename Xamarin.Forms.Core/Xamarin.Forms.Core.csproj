<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageId>Extension.Xamarin.Forms.Gtk4.Core</PackageId>
        <Description>Core assembly of Xamarin.Forms: the cross-platform UI abstraction.</Description>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'"></PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.0|AnyCPU'"></PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Xamarin.Forms.Platform\Xamarin.Forms.Platform.Base.csproj" />
    </ItemGroup>
    <!--
		netstandard1.0 support removed: Internals\Legacy\** (FileAccess/FileMode/FileShare
		shims) existed only for that leg, as did the System.ComponentModel /
		System.Dynamic.Runtime / System.ValueTuple 4.x package references.
	-->
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Xaml\Diagnostics\" />
    </ItemGroup>
    <PropertyGroup>
        <GitInfoReportImportance>high</GitInfoReportImportance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
  <!-- macOS CI: the GitHub macOS-arm64 runner fails netstandard2.0 compiles with CS0518 because the
       SDK's implicit NETStandard.Library.Ref is not resolved. Reference it explicitly so the
       netstandard facade is supplied from the package. In-project rather than Directory.Build.targets
       because on that runner the shared import is evaluated inconsistently and skips most projects; a
       project-file PackageReference is always in the restore graph. No-op on Windows/Linux. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="NETStandard.Library" Version="2.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
