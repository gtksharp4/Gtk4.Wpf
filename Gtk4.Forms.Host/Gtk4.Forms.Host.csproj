<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageId>Gtk4.Forms.Host</PackageId>
        <Description>Reflection-based GTK 4 host for Xamarin.Forms: discovers the Application subclass and runs the GTK main loop.</Description>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- Assembly identity stays Xamarin.Forms.* (dirs/project/package use Gtk4.Forms.*). -->
        <AssemblyName>Xamarin.Forms.Host</AssemblyName>
        <!-- Capital GTK: a lowercase RootNamespace shadows GtkSharp's global Gtk namespace. -->
        <RootNamespace>Xamarin.Forms.Platform.GTK</RootNamespace>
        <LangVersion>latest</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <!-- Demote obsolete-API warnings while the GtkSharp4 compat shims are in use. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="GtkSharp4" Version="$(GtkSharp4Version)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Gtk4.Forms.Platform.Gtk\Gtk4.Forms.Platform.Gtk.csproj" />
        <ProjectReference Include="..\Gtk4.Forms.Core\Gtk4.Forms.Core.csproj" />
    </ItemGroup>
    <!-- macOS CI: netstandard2.0 targeting pack resolves to nothing on the macOS-arm64 runner.
         Disable the implicit framework reference and reference netstandard.dll explicitly. -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <PackageReference Include="NETStandard.Library" Version="2.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
        <Reference Include="$(PkgNETStandard_Library)/build/netstandard2.0/ref/*.dll" Private="false" />
    </ItemGroup>
</Project>
