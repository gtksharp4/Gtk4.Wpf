<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Xamarin.Forms.Platform.GTK.UnitTests</AssemblyName>
    <RootNamespace>Xamarin.Forms.Platform.GTK.UnitTests</RootNamespace>
    <!-- xUnit v3 test projects are executables, not libraries - same as Xaml.UnitTests. -->
    <OutputType>Exe</OutputType>
    <!--
      Disable xUnit v3's auto-generated entry point: Program.cs provides a custom one. It keeps the
      Microsoft Testing Platform path (dotnet test / VS) identical to the generated entry, and adds a
      thread-0 path for macOS, where GTK 4's Quartz backend must run on the process's first thread
      (scripts/ci/test-macos.sh runs this assembly with `dotnet exec`). SelfRegisteredExtensions and
      the Testing Platform framework type stay generated, so the dotnet-test path is unchanged.
    -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <IsPackable>true</IsPackable>
    <LangVersion>latest</LangVersion>
    <!--
      SDK-style default globbing on purpose (plan D3/§10.2): the legacy explicit
      <Compile Include> style of Xamarin.Forms.Core.UnitTests.csproj silently ignores a new
      test file, which is exactly the trap this project exists to avoid.
    -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!--
      xUnit1031 ("do not use blocking task operations in a test method") fires on
      GtkTestHost.Await, which blocks deliberately, after pumping the GTK main loop. The
      advisory alternative - an async test method - is exactly what deadlocks this suite;
      see the comment on GtkTestHost.Await.
    -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
    <!--
      GTK4 port: GtkSharp4 marks many GTK3 compat shims [Obsolete] (CS0612/CS0618) but keeps
      them functional. With TreatWarningsAsErrors every such call is a hard error; allow them
      here the same way Xamarin.Forms.Platform.GTK.csproj does.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xamarin.Forms.Core\Xamarin.Forms.Core.csproj" />
    <ProjectReference Include="..\Xamarin.Forms.Platform.GTK\Xamarin.Forms.Platform.GTK.csproj" />
  </ItemGroup>

</Project>
