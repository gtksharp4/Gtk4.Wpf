<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  Meta-package: ships no compiled code of its own. Its purpose is to:
	    1. Pull in the Gtk4.* dependency chain (WindowsBase, PresentationFramework,
	       MarkupCompiler) so a consumer needs only one PackageReference.
	    2. Pack Gtk4.Wpf.props/.targets into build/ and buildTransitive/ so NuGet
	       auto-imports them in the consumer (NuGet only auto-imports
	       build/$(PackageId).props|.targets).
	       buildTransitive/ ensures the assets also flow to projects that reach this package
	       transitively — build/ assets do not flow past the direct consumer.
	    3. Pack the Gtk4.Wpf.ProjectConverter tool DLL into tools/ so Gtk4.Wpf.targets can
	       invoke it via `dotnet <dll>` (RID-agnostic, no instance guard) to rewrite the
	       consumer .csproj (strip UseWPF/UseWindowsForms, collapse TFM; OutputType is left as-is,
	       so a WPF app keeps its WinExe). No injected Main is needed: WPF's entry point comes
	       from the ApplicationDefinition compiled by the MarkupCompiler.
	-->
	<PropertyGroup>
		<PackageId>Gtk4.Wpf</PackageId>
		<Description>Meta-package: add one PackageReference to run an existing WPF app on GTK 4 without editing controls, XAML, usings or namespaces. The package rewrites the consumer .csproj and pulls in the Gtk4.Wpf WPF compatibility layer.</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
		<!--
		  Keep this. SetVersions overwrites Version at build time, but restore never runs targets,
		  and without an explicit Version the SDK would compose one from the Directory.Build.props
		  fallbacks as $(VersionPrefix)-$(VersionSuffix), i.e. the prerelease "1.0.0-0", and record
		  that in project.assets.json — breaking the version the meta-package advertises to consumers.
		-->
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
		<IsPackable>true</IsPackable>
		<!--
		  This project ships no compiled code — only NuGet dependencies, build wiring and content.
		  Disabling default compile items and build output keeps the nupkg clean and avoids a
		  spurious lib/netstandard2.0/ folder that would shadow the real assemblies.
		-->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>False</IncludeSymbols>
	</PropertyGroup>

	<!--
	  The WindowsDesktop shared framework supplied System.Configuration.ConfigurationManager (the
	  ApplicationSettingsBase behind every WPF Properties/Settings.Designer.cs) implicitly; the
	  converter drops it with UseWPF. Declaring it here puts it in this package's nuspec, so it
	  reaches direct and transitive consumers and survives re-conversion, with no edit to the
	  consumer csproj. No TFM condition: the package ships netstandard2.0, net8.0 and net10.0 assets.
	-->
	<ItemGroup>
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
		<!-- UserPreferenceChangedEventArgs and friends (SystemEvents), also from the WindowsDesktop shared framework. -->
		<PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
		<!-- CAS types (SecurityPermission, EnvironmentPermission, ...) from the WindowsDesktop shared framework (PermissionSet, SecurityPermission). -->
		<PackageReference Include="System.Security.Permissions" Version="10.0.0" />
	</ItemGroup>

	<!--
	  nuspec dependencies: NuGet turns each ProjectReference (without ReferenceOutputAssembly=false
	  / PrivateAssets=all) into a <dependency> in the generated .nuspec, so consumers get the
	  full WPF-compat stack pulled in automatically on restore.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Gtk4.WindowsBase\Gtk4.WindowsBase.csproj" />
		<ProjectReference Include="..\Gtk4.PresentationFramework\Gtk4.PresentationFramework.csproj" />
		<ProjectReference Include="..\Gtk4.MarkupCompiler\Gtk4.MarkupCompiler.csproj" />
		<!--
		  Build-order dependency only: the ProjectConverter DLL must exist in
		  bin/$(Configuration)/net10.0/ before this project packs (the None glob below needs it).
		  ReferenceOutputAssembly=false keeps its assembly out of our compile; PrivateAssets=all
		  keeps it out of the nuspec dependency list — consumers do not need it at restore time,
		  only at build time via the packed tools/. SkipGetTargetFrameworkProperties=true suppresses
		  the cross-TFM compatibility check: this netstandard2.0 project only needs the net10.0 tool
		  to BUILD first, it never references its output, so the normal "net10.0 cannot be referenced
		  by netstandard2.0" error must not apply.
		-->
		<ProjectReference Include="..\Gtk4.Wpf.ProjectConverter\Gtk4.Wpf.ProjectConverter.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net10.0'" />
	</ItemGroup>

	<!--
	  Pack items: build wiring and the converter tool.
	  NuGet auto-imports build/$(PackageId).props and build/$(PackageId).targets in the direct
	  consumer; buildTransitive/ copies ensure the same assets reach transitive consumers.
	-->
	<ItemGroup>
		<!--
		  Empty placeholder: this package ships no assembly of its own (IncludeBuildOutput=false), but
		  it declares net10.0 dependencies (PresentationFramework needs GtkSharp4, so the stack is
		  net10.0). NuGet's NU5128 requires a lib/ folder matching the dependency group's TFM; the
		  canonical "_._" marker satisfies it without shipping a real lib.
		-->
		<!-- Forward slashes: on Linux/macOS a backslash PackagePath is not a separator (NU5129). -->
		<None Include="_._" Pack="true" PackagePath="lib/net10.0/_._" />
		<None Include="_._" Pack="true" PackagePath="lib/net8.0/_._" />
		<None Include="_._" Pack="true" PackagePath="lib/netstandard2.0/_._" />
		<None Include="Gtk4.Wpf.props" Pack="true" PackagePath="build/;buildTransitive/" />
		<None Include="Gtk4.Wpf.targets" Pack="true" PackagePath="build/;buildTransitive/" />
		<!--
		  Pack the entire net10.0 output of ProjectConverter into tools/ so Gtk4.Wpf.targets can
		  invoke it as `dotnet tools/Gtk4.Wpf.ProjectConverter.dll` (RID-agnostic). The Link
		  metadata is cosmetic (shown in VS) but does not affect the PackagePath.
		-->
		<None Include="../Gtk4.Wpf.ProjectConverter/$(BaseOutputPath)$(Configuration)/net10.0/**" Pack="true" PackagePath="tools/" />
	</ItemGroup>
</Project>
