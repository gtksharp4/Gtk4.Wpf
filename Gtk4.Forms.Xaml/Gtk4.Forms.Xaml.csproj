<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageId>Gtk4.Forms.Xaml</PackageId>
        <!-- Assembly identity stays Xamarin.Forms.* (only project/dir/package were renamed); the
             InternalsVisibleTo grants across the tree key off the Xamarin.Forms.* assembly names. -->
        <AssemblyName>Xamarin.Forms.Xaml</AssemblyName>
        <RootNamespace>Xamarin.Forms.Xaml</RootNamespace>
        <Description>XAML loader and markup support for Xamarin.Forms.</Description>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Gtk4.Forms.Core\Gtk4.Forms.Core.csproj"></ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
    <!-- macOS CI: the GitHub macOS-arm64 runner's netstandard2.0 targeting pack resolves to nothing, so
       every compile fails with CS0518 "System.Object is not defined", and the SDK suppresses the
       NETStandard.Library package's own build targets (it treats the package as implicit). Disable the
       implicit framework reference and reference netstandard.dll explicitly from the restored package -
       a user Reference the SDK does not strip. Reference the complete facade set (what the targeting
       pack ships), so netstandard.dll supplies the surface and the package's System.* facades dedupe
       any legacy facade a NuGet dependency drags in (e.g. Controls.Gtk -> System.Threading.Thread,
       which would otherwise collide: CS0433). No-op on Windows/Linux. -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="NETStandard.Library" Version="2.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="build;buildTransitive" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="$(PkgNETStandard_Library)/build/netstandard2.0/ref/*.dll" Private="false" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    </ItemGroup>
</Project>