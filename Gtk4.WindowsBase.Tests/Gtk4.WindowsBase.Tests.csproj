<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk4.WindowsBase.Tests</AssemblyName>
    <RootNamespace>Gtk4.WindowsBase.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <!-- Suppress advisory xUnit rules imported from the analyzer package. -->
    <NoWarn>$(NoWarn);xUnit1026;xUnit1031;xUnit1051;xUnit2000;xUnit2003;xUnit2004;xUnit2007;xUnit2013;xUnit2015;xUnit2017;xUnit2021</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk4.WindowsBase\Gtk4.WindowsBase.csproj" />
  </ItemGroup>

</Project>
