<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repo-scoped feed list. <clear /> is deliberate: without it NuGet inherits
    parent-directory configs, and a Windows-only local source (e.g. D:\...\Packages)
    breaks restore when the same tree is built from WSL/Linux.
    dotnet-eng is required by the upstream build, see README.md "Getting Started".
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-eng" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json" protocolVersion="3" />
    <add key="Local" value="Packages" />
    <!--
      Vendored GtkSharp4 wrapper packages, committed under build/gtksharp4-packages/. The GTK 4
      binding is a hard fork not published to nuget.org, and the machine-local "Local" feed above is
      a developer convenience (a symlink to a shared feed) that does not exist on a CI runner or a
      fresh clone. Committing the 8 wrapper nupkgs (~1.7 MB) makes `dotnet restore` self-contained
      everywhere. Refresh them with build/update-gtksharp4-packages.ps1 when the binding changes.
    -->
    <add key="GtkSharp4Vendored" value="build/gtksharp4-packages" />
  </packageSources>
</configuration>
