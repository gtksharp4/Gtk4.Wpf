<Project>
  <!--
    Registers MarkupCompileTask, discovers WPF XAML files (Page + ApplicationDefinition build
    items) and adds the generated .g.cs files to @(Compile) before CoreCompile runs.
    Guard prevents double-import when both build/ and buildTransitive/ are applied.
  -->

  <PropertyGroup>
    <_GFMarkupCompilerTargetsImportedAgain
        Condition="'$(_GFMarkupCompilerTargetsImported)' == 'true'">true</_GFMarkupCompilerTargetsImportedAgain>
    <_GFMarkupCompilerTargetsImported>true</_GFMarkupCompilerTargetsImported>
  </PropertyGroup>

  <Target Name="_ValidateGFMarkupCompilerImport"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          Condition="'$(GFDisableMarkupCompilerValidation)' != 'true'">
    <Error Code="GF001"
           Condition="'$(_GFMarkupCompilerTargetsImportedAgain)' == 'true'"
           Text="Gtk4.MarkupCompiler targets imported more than once. Remove the duplicate import." />
  </Target>

  <UsingTask TaskName="Gtk4.MarkupCompiler.MarkupCompileTask"
             AssemblyFile="$(_GFMarkupCompilerTasksDir)Gtk4.MarkupCompiler.dll"
             Condition="'$(_GFMarkupCompilerUseTaskHost)' != 'true'" />
  <!-- In-tree builds: an out-of-proc task host so reused MSBuild nodes don't lock the task DLL. -->
  <UsingTask TaskName="Gtk4.MarkupCompiler.MarkupCompileTask"
             AssemblyFile="$(_GFMarkupCompilerTasksDir)Gtk4.MarkupCompiler.dll"
             TaskFactory="TaskHostFactory"
             Condition="'$(_GFMarkupCompilerUseTaskHost)' == 'true'" />

  <!--
    Collect Page and ApplicationDefinition XAML items.
    Incremental: only re-runs when inputs are newer than outputs.
  -->
  <Target Name="_GFMarkupCompile"
          BeforeTargets="CoreCompile"
          Condition="'@(Page)' != '' or '@(ApplicationDefinition)' != ''">

    <!--
      Resolve the output directory here, not at import time: a project that imports these targets
      mid-.csproj (before the SDK sets IntermediateOutputPath, e.g. Gtk4.WpfSample) would
      otherwise default it to a project-root folder, which the default **/*.cs glob then compiles
      alongside the copy added below (CS2002). At target-execution time IntermediateOutputPath is
      always set, so the generated files land under obj/.
    -->
    <PropertyGroup>
      <GFMarkupOutputDir
          Condition="'$(GFMarkupOutputDir)' == ''">$(IntermediateOutputPath)gf-wpf-generated\</GFMarkupOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <_GFWpfXamlInputs Include="@(ApplicationDefinition)" GFItemType="ApplicationDefinition" />
      <_GFWpfXamlInputs Include="@(Page)" GFItemType="Page" />
    </ItemGroup>

    <MarkupCompileTask
        XamlFiles="@(_GFWpfXamlInputs)"
        OutputDirectory="$(GFMarkupOutputDir)"
        RootNamespace="$(RootNamespace)"
        ProjectDirectory="$(MSBuildProjectDirectory)"
        ReferencePaths="@(ReferencePath)"
        CompileFiles="@(Compile)">
      <Output TaskParameter="GeneratedFiles" ItemName="_GFGeneratedCs" />
    </MarkupCompileTask>

    <!--
      Remove any pre-existing @(Compile) entry for the generated files before adding them, so a
      project that already globbed them (e.g. a consumer that overrides GFMarkupOutputDir to a
      project-relative folder) does not compile them twice (CS2002).
    -->
    <ItemGroup>
      <Compile Remove="@(_GFGeneratedCs)" />
      <Compile Include="@(_GFGeneratedCs)" />
      <FileWrites Include="@(_GFGeneratedCs)" />
    </ItemGroup>

  </Target>

</Project>
