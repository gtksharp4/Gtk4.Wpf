<Project>
  <Import Condition="'$(SampleProject)' != 'true'" Project="Git.Build.targets" />
  <Import Condition="'$(SampleProject)' != 'true'" Project="Version.targets" />

  <!--
    Net4x.NuGetUtility's build\Net4x.NuGetUtility.props packs the solution-root README.md at
    the package root, while every packable project here packs its own README.md at
    \README.md. Two files claiming \README.md is NU5118, which TreatWarningsAsErrors turns
    into a build failure. The per-project README is the one to keep, so drop the item the
    package added.

    Removed from .targets, not .props: the item does not exist yet when Directory.Build.props
    is evaluated. $(NuGetUtility) is set by those same package props, so this is a no-op for
    projects that do not reference the package. The expression also matches the case of a
    project built outside the solution, where SolutionDir is empty and the package's
    Exists() check resolves README.md relative to the project directory.
  -->
  <ItemGroup Condition="'$(NuGetUtility)' == 'true'">
    <None Remove="$(SolutionDir)README.md" />
  </ItemGroup>

  <!--
    macOS CI only (scripts/ci/test-macos.sh sets XFPinNetStandardRef). The GitHub macOS runner
    regressed to failing netstandard2.0 compiles with CS0518 "Predefined type 'System.Object' is not
    defined": the SDK's implicit NETStandard.Library.Ref targeting pack is not resolved and csc is
    handed no references (the same build was green on an earlier runner image). Referencing the
    metapackage supplies the netstandard facade from the package instead.

    In .targets, NOT .props: $(TargetFramework) is not yet set when Directory.Build.props is
    evaluated (see the NuGetUtility note above), so the same ItemGroup in .props matched only the
    projects whose evaluation happened to have it set. Here it is reliably set for every project.
    Scoped by property so the Windows and Linux jobs are untouched.
  -->
  <ItemGroup Condition="'$(XFPinNetStandardRef)' == 'true' AND '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="NETStandard.Library" Version="2.0.3" PrivateAssets="all" />
  </ItemGroup>
 </Project>
