<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target so the Windows variant can carry the CefSharp WebBrowser backend. The
      net10.0-windows TFM is only added when building ON Windows, so the Linux/macOS CI keeps
      building the single cross-platform net10.0 (Photino) variant and never pulls CefSharp
      (whose build targets are Windows-only). NuGet hands net10.0-windows consumers the CefSharp
      variant and everyone else the net10.0 (Photino) one.
    -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">netstandard2.0;net8.0;net8.0-windows;net10.0;net10.0-windows</TargetFrameworks>
    <AssemblyName>Gtk4.PresentationFramework</AssemblyName>
    <RootNamespace>System.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Packable (restored transitively via Gtk4.Wpf); stable 4-part Version avoids NU5104. -->
    <IsPackable>true</IsPackable>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
    <!-- Suppress CS0436: type conflicts with imported type (expected when building in-tree with
         System.Windows.* namespaces that may partially shadow BCL types on some TFMs). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- GTK4 port: GtkSharp4 marks many GTK3 compat shims [Obsolete]; demote to warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controls\WebBrowser.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\WebBrowser.History.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\WebBrowser.Navigation.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\WebBrowser.Script.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\Web\CefSharpWebBrowserHost.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\Web\IWebBrowserHost.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\Web\PhotinoWebBrowserHost.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="Controls\Web\WebBrowserDom.cs" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <Compile Remove="System.Collections.Generic\ReferenceEqualityComparer.cs" Condition="'$(TargetFramework)'!='netstandard2.0'" />
    <Compile Remove="System\ArgumentNullExceptionExtension.cs" Condition="'$(TargetFramework)'!='netstandard2.0'" />
    <Compile Remove="System\NetStandardCompatibilityAttributes.cs" Condition="'$(TargetFramework)'!='netstandard2.0'" />
    <Compile Remove="System\TupleExtensions.cs" Condition="'$(TargetFramework)'!='netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gtk4.PresentationFramework.Tests" Key="$(Gtk4FormsPublicKey)" />
    <InternalsVisibleTo Include="Gtk4.Wpf.Testing" Key="$(Gtk4FormsPublicKey)" />
    <InternalsVisibleTo Include="Gtk4.Wpf.Testing.Tests" Key="$(Gtk4FormsPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk4.WindowsBase\Gtk4.WindowsBase.csproj" />
    <EmbeddedResource Include="..\GtkSharp.png" LogicalName="Gtk4.PresentationFramework.GtkSharp.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ValueTuple" Version="4.6.2" Condition="'$(TargetFramework)'=='netstandard2.0'" />
    <PackageReference Include="GtkSharp4" Version="$(GtkSharp4Version)" />
    <PackageReference Include="Photino.NET" Version="4.0.16" Condition="'$(TargetFramework)'=='net10.0' or '$(TargetFramework)'=='net8.0' or '$(TargetFramework)'=='net10.0-windows' or '$(TargetFramework)'=='net8.0-windows'" />
  </ItemGroup>

  <!--
    Windows variant only: a visible CefSharp.WinForms browser backs the WebBrowser control
    (see Controls/Web/CefSharpWebBrowserHost.cs, compiled under the net10.0-windows WINDOWS
    symbol). UseWindowsForms enables the WinForms Form that hosts the Chromium control;
    CefSharpAnyCpuSupport lets CefSharp load its native binaries from an AnyCPU assembly.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows' or '$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
    <CefSharpAnyCpuSupport>true</CefSharpAnyCpuSupport>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0-windows' or '$(TargetFramework)'=='net8.0-windows'">
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="156.0.150" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Controls\Web\" />
    <Folder Include="System.Collections.Generic\" />
  </ItemGroup>

  <!--
    No macOS netstandard2.0 workaround here: that fix (DisableImplicitFrameworkReferences +
    referencing the netstandard2.0 ref assemblies) belongs ONLY on the sibling netstandard2.0
    projects, whose targeting pack the macOS-arm64 runner fails to resolve. This project targets
    net10.0, whose framework reference the runner resolves normally; forcing the netstandard2.0
    refs here instead stripped net10.0's BCL and broke the compile (ReferenceEqualityComparer,
    the 3-arg Enumerable.Contains, nullable-annotated overloads, etc.).
  -->

</Project>
