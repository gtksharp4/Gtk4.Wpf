    <ProjectReference Include="..\Gtk4.Forms.Maps\Gtk4.Forms.Maps.csproj" />
    <ProjectReference Include="..\Gtk4.Forms.Xaml\Gtk4.Forms.Xaml.csproj" />
  </ItemGroup>
</Project>
