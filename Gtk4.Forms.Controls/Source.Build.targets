<Project>
  <Import Project="..\Gtk4.Forms.Build.Tasks\build\Gtk4.Forms.targets" Condition="'$(BuildingInsideVisualStudio)' == 'true' AND Exists('$(__XFBuildTasksLocation)Gtk4.Forms.Build.Tasks.dll')" />
