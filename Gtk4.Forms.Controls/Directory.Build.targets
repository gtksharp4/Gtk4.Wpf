<Project>
    <!-- Chain the root (Version.targets, Git.Build.targets) — a per-project file stops the auto-walk. -->
    <Import Project="..\Directory.Build.targets" />
    <!-- Import the XAML MSBuild tasks (XamlGTask generates InitializeComponent + x:Name fields, XamlCTask
         compiles the XAML). Without this, every .xaml.cs fails with CS0103 on InitializeComponent. The
         targets file keeps its Gtk4.Forms.* name inside the Gtk4.Forms.Build.Tasks package. -->
    <Import Project="..\Gtk4.Forms.Build.Tasks\build\Gtk4.Forms.targets" Condition="$(FromSource) == 'true' AND '$(BuildingInsideVisualStudio)' == 'true' AND Exists('$(__XFBuildTasksLocation)Gtk4.Forms.Build.Tasks.dll')" />
    <Import Project="..\Gtk4.Forms.Build.Tasks\build\Gtk4.Forms.targets" Condition="$(FromSource) == 'true' AND '$(BuildingInsideVisualStudio)' != 'true'" />
</Project>
