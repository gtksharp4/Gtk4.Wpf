<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk4.Integration.Tests</AssemblyName>
    <RootNamespace>Gtk4.Integration.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The sample solution files are shipped as embedded resources, not compiled/copied. -->
  <ItemGroup>
    <Compile Remove="Resources/**" />
    <None Remove="Resources/**" />
    <EmbeddedResource Include="Resources/WpfAppToConvert.slnx"><LogicalName>WpfAppToConvert.slnx</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/WpfAppToConvert.csproj"><LogicalName>WpfAppToConvert.csproj</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/App.xaml"><LogicalName>App.xaml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/App.xaml.cs"><LogicalName>App.xaml.cs</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/MainWindow.xaml"><LogicalName>MainWindow.xaml</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/MainWindow.xaml.cs"><LogicalName>MainWindow.xaml.cs</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Resources/AssemblyInfo.cs"><LogicalName>AssemblyInfo.cs</LogicalName></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
