<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <PackageId>Extension.Xamarin.Forms.Gtk4.Maps.GTK</PackageId>
        <Description>GTK4 map renderer for Xamarin.Forms.Maps, drawn with Cairo over OpenStreetMap-compatible tiles.</Description>
        <IsPackable>true</IsPackable>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>Xamarin.Forms.Maps.GTK</AssemblyName>
        <RootNamespace>Xamarin.Forms.Maps.GTK</RootNamespace>
        <LangVersion>latest</LangVersion>
        <!--
          TRUE, so the SDK emits AssemblyVersion/FileVersion/InformationalVersion from the
          values Version.targets computes. With it off, and a hand-written AssemblyInfo.cs
          that carries only ExportRenderer/Dependency attributes, these two shipping
          assemblies compiled with AssemblyVersion 0.0.0.0 while Core and Xaml carried the
          intended 2.0.0.0 - so binding redirects and any strong-name identity check saw a
          version the rest of the framework never uses.
        -->
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
        <!-- GTK4 port bootstrap: see the same note in Xamarin.Forms.Platform.GTK.csproj. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" Condition="'$(OS)' == 'Windows_NT'" />
        <!--
          Pinned explicitly, to the same version as Xamarin.Forms.Platform.GTK. See the comment
          there: the Net4x.NuGetUtility tooling has property-ised this reference before and broken
          restore with "'.' is not a valid version string". Do not let it be property-ised again -
          it has already happened twice. $(InputBoxLibraryVersion) and $(VersionBuildSuffix) are
          unrelated and undefined here, so the version evaluated to the bare string ".".
        -->
        <PackageReference Include="GtkSharp4" Version="$(GtkSharp4Version)" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Xamarin.Forms.Core\Xamarin.Forms.Core.csproj" />
        <ProjectReference Include="..\Xamarin.Forms.Maps\Xamarin.Forms.Maps.Base.csproj" />
        <ProjectReference Include="..\Xamarin.Forms.Platform.GTK\Xamarin.Forms.Platform.GTK.csproj" />
    </ItemGroup>
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
  <!-- macOS CI: the GitHub macOS-arm64 runner's netstandard2.0 targeting pack resolves to nothing, so
       every compile fails with CS0518 "System.Object is not defined", and the SDK suppresses the
       NETStandard.Library package's own build targets (it treats the package as implicit). Disable the
       implicit framework reference and reference netstandard.dll explicitly from the restored package -
       a user Reference the SDK does not strip. netstandard.dll is the whole netstandard2.0 ref surface.
       No-op on Windows/Linux. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="NETStandard.Library" Version="2.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
    <Reference Include="$(PkgNETStandard_Library)/build/netstandard2.0/ref/netstandard.dll" Private="false" />
  </ItemGroup>
</Project>
