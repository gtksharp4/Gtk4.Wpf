<Window x:Class="WpfAppToConvert.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppToConvert"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="ActionButton" Content="Click Me" Width="120" Margin="0,0,0,10" Click="ActionButton_Click"/>
            <Button x:Name="ShowDateTimeButton" Content="Show DateTime" Width="120" Margin="0,0,0,10" Click="ShowDateTimeButton_Click"/>
            <Button x:Name="OpenDialogButton" Content="Open Dialog" Width="120" Margin="0,0,0,10" Click="OpenDialogButton_Click"/>
            <Label x:Name="ResultLabel" Content="Label" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
