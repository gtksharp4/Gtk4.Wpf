<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<!--
	  Meta-package: ships no compiled code of its own. Its purpose is to:
	    1. Pull in the Gtk4.Forms.* dependency chain (Core, Xaml, Platform.Gtk, Build.Tasks, Host)
	       so a consumer needs only one PackageReference.
	    2. Pack Gtk4.Forms.Base.props/.targets into build/ and buildTransitive/ so NuGet auto-imports
	       them in the consumer (NuGet only auto-imports build/$(PackageId).props|.targets).
	       buildTransitive/ ensures the assets also flow to projects that reach this package
	       transitively — build/ assets do not flow past the direct consumer.
	    3. Pack content/GtkEntryPoint.g.cs as the injected Main that calls GtkHost.Run.
	    4. Pack the Gtk4.Forms.ProjectConverter tool DLL into tools/ so Base.targets can invoke it
	       via `dotnet <dll>` (RID-agnostic, no instance guard) to rewrite the consumer .csproj.
	-->
	<PropertyGroup>
		<PackageId>Gtk4.Forms.Base</PackageId>
		<Description>Meta-package: add one PackageReference to run an existing Gtk4.Forms app on GTK 4 without editing controls, XAML, usings or namespaces. The package rewrites the consumer .csproj and injects a GTK entry point.</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
		<!--
		  Keep this. SetVersions overwrites Version at build time, but restore never runs targets,
		  and without an explicit Version the SDK would compose one from the Directory.Build.props
		  fallbacks as $(VersionPrefix)-$(VersionSuffix), i.e. the prerelease "1.0.0-0", and record
		  that in project.assets.json — breaking the version the meta-package advertises to consumers.
		-->
		<Version>$(VersionPrefix).$(VersionSuffix)</Version>
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<!--
		  This project ships no compiled code — only NuGet dependencies, build wiring and content.
		  Disabling default compile items and build output keeps the nupkg clean and avoids a
		  spurious lib/netstandard2.0/ folder that would shadow the real assemblies.
		-->
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<IncludeBuildOutput>false</IncludeBuildOutput>
	</PropertyGroup>

	<!--
	  nuspec dependencies: NuGet turns each ProjectReference (without ReferenceOutputAssembly=false
	  / PrivateAssets=all) into a <dependency> in the generated .nuspec, so consumers get
	  Core/Xaml/Platform.Gtk/Build.Tasks/Host pulled in automatically on restore.
	-->
	<ItemGroup>
		<ProjectReference Include="..\Gtk4.Forms.Core\Gtk4.Forms.Core.csproj" />
		<ProjectReference Include="..\Gtk4.Forms.Xaml\Gtk4.Forms.Xaml.csproj" />
		<ProjectReference Include="..\Gtk4.Forms.Platform.Gtk\Gtk4.Forms.Platform.Gtk.csproj" />
		<ProjectReference Include="..\Gtk4.Forms.Build.Tasks\Gtk4.Forms.Build.Tasks.csproj" />
		<ProjectReference Include="..\Gtk4.Forms.Host\Gtk4.Forms.Host.csproj" />
		<!--
		  Build-order dependency only: the ProjectConverter DLL must exist in
		  bin/$(Configuration)/net10.0/ before this project packs (the None glob below needs it).
		  ReferenceOutputAssembly=false keeps its assembly out of our compile; PrivateAssets=all
		  keeps it out of the nuspec dependency list — consumers do not need it at restore time,
		  only at build time via the packed tools/. SkipGetTargetFrameworkProperties=true suppresses
		  the cross-TFM compatibility check: this netstandard2.0 project only needs the net10.0 tool to
		  BUILD first, it never references its output, so the normal "net10.0 cannot be referenced by
		  netstandard2.0" error must not apply.
		-->
		<ProjectReference Include="..\Gtk4.Forms.ProjectConverter\Gtk4.Forms.ProjectConverter.csproj"
		                  ReferenceOutputAssembly="false"
		                  SkipGetTargetFrameworkProperties="true"
		                  PrivateAssets="all" />
	</ItemGroup>

	<!--
	  Pack items: build wiring, injected host source, and the converter tool.
	  NuGet auto-imports build/$(PackageId).props and build/$(PackageId).targets in the direct
	  consumer; buildTransitive/ copies ensure the same assets reach transitive consumers.
	-->
	<ItemGroup>
		<!--
		  Empty placeholder: this package ships no assembly of its own (IncludeBuildOutput=false), but
		  it declares netstandard2.0 dependencies. NuGet's NU5128 requires a lib/ folder matching the
		  dependency group's TFM; the canonical "_._" marker satisfies it without shipping a real lib.
		-->
		<None Include="_._" Pack="true" PackagePath="\lib\netstandard2.0\_._" />
		<None Include="Gtk4.Forms.Base.props"      Pack="true" PackagePath="\build\;\buildTransitive\" />
		<None Include="Gtk4.Forms.Base.targets"    Pack="true" PackagePath="\build\;\buildTransitive\" />
		<None Include="content\GtkEntryPoint.g.cs" Pack="true" PackagePath="\content\" />
		<!--
		  Pack the entire net10.0 publish output of ProjectConverter into tools/ so Base.targets can
		  invoke it as `dotnet tools/Gtk4.Forms.ProjectConverter.dll` (RID-agnostic). The Link
		  metadata is cosmetic (shown in VS) but does not affect the PackagePath.
		-->
		<None Include="..\Gtk4.Forms.ProjectConverter\bin\$(Configuration)\net10.0\**"
		      Pack="true"
		      PackagePath="\tools\" />
	</ItemGroup>
</Project>
