<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Gtk.Forms.PresentationFramework.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Gtk.Forms.PresentationFramework</AssemblyName>
    <RootNamespace>System.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Packable (restored transitively via Gtk.Forms.Base); stable 4-part Version avoids NU5104. -->
    <IsPackable>true</IsPackable>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
    <!-- Suppress CS0436: type conflicts with imported type (expected when building in-tree with
         System.Windows.* namespaces that may partially shadow BCL types on some TFMs). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <!-- GTK4 port: GtkSharp4 marks many GTK3 compat shims [Obsolete]; demote to warnings. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0612;CS0618</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gtk.Forms.WindowsBase\Gtk.Forms.WindowsBase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GtkSharp4" Version="$(GtkSharp4Version)" />
  </ItemGroup>

  <!-- macOS CI: same workaround as the sibling netstandard2.0 projects. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="NETStandard.Library" Version="2.0.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="build;buildTransitive" />
    <Reference Include="$(PkgNETStandard_Library)/build/netstandard2.0/ref/*.dll" Private="false" />
  </ItemGroup>

</Project>
