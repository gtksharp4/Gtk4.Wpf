<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageId>Extension.Xamarin.Forms.Gtk4.Platform.Base</PackageId>
        <!-- Assembly identity is independent of the .csproj file name: Core grants
             InternalsVisibleTo("Xamarin.Forms.Platform") and AssemblyInfoTests does
             Assembly.Load("Xamarin.Forms.Platform"). -->
        <AssemblyName>Xamarin.Forms.Platform</AssemblyName>
        <RootNamespace>Xamarin.Forms.Platform</RootNamespace>
        <Description>Platform facade referenced by the Xamarin.Forms renderers.</Description>
        <IsPackable>true</IsPackable>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" Condition="'$(OS)' == 'Windows_NT'" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'"></PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|netstandard2.0|AnyCPU'"></PropertyGroup>
  <!-- macOS CI: the GitHub macOS-arm64 runner's netstandard2.0 targeting pack resolves to nothing and
       overrides any package refs, failing every compile with CS0518 "System.Object is not defined".
       DisableImplicitFrameworkReferences drops that targeting-pack path; the NETStandard.Library
       package then supplies netstandard.dll itself. In-project (not Directory.Build.props) because the
       property must be set before the SDK adds the implicit reference, and the net10.0 test projects
       must keep theirs. No-op on Windows/Linux. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="NETStandard.Library" Version="2.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
