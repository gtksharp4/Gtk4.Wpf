<Window x:Class="Gtk4.Forms.PresentationFramework.Tests.XamlBacked.InkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ink" Width="300" Height="200">
	<Window.Resources>
		<Style TargetType="InkCanvas"><Setter Property="Background" Value="LightGray"/></Style>
	</Window.Resources>
	<InkCanvas x:Name="Ink" EditingMode="{x:Static InkCanvasEditingMode.Select}">
		<Button x:Name="Pinned" InkCanvas.Left="20" InkCanvas.Top="10" Content="b"/>
	</InkCanvas>
</Window>
