<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Gtk4.WindowsBase.Tests" Key="$(Gtk4FormsPublicKey)" />
    <InternalsVisibleTo Include="Gtk4.PresentationFramework" Key="$(Gtk4FormsPublicKey)" />
    <InternalsVisibleTo Include="Gtk4.PresentationFramework.Tests" Key="$(Gtk4FormsPublicKey)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Gtk4.WindowsBase</AssemblyName>
    <RootNamespace>System.Windows</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Packable (a consumer restores it transitively via Gtk4.Wpf). The stable 4-part Version
         keeps the Base package's dependency on it stable rather than prerelease (NU5104). -->
    <IsPackable>true</IsPackable>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <PackageOutputPath>$(XFPackageOutputPath)</PackageOutputPath>
    <!-- Suppress CS0436: type conflicts with imported type (expected when building in-tree with
         System.Windows.* namespaces that may partially shadow BCL types on some TFMs). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
